__pycache__/
*.py[cod]

# Work Orders written by cli.py — generated output, not source
output/

# generated by make_sample_sheet.py — regenerate rather than commit,
# since the port ids go stale as soon as a plan is executed
data/sample_demand*.xlsx

# atomic-write scratch file from pathengine.save_topology; a crashed write can
# leave one behind, and it must never be committed
data/*.tmp
