__pycache__/
*.py[cod]

# Work Orders written by cli.py — generated output, not source
output/

# generated by make_sample_sheet.py — regenerate rather than commit,
# since the port ids go stale as soon as a plan is executed
data/sample_demand*.xlsx

# atomic-write scratch file from pathengine.save_topology; a crashed write can
# leave one behind, and it must never be committed
data/*.tmp

# built by make_transfer.py; a build product, rebuilt on demand
ITA_transfer.xlsx
_stage/
_backup_*/
TRANSFER_INSTRUCTIONS.txt

# written by ita_probe.py on the closed network; holds real ITA data, so it
# must never be committed or travel back
probe_out/

# written by ita_sync.py on the closed network: the local copy of real ITA
# data. Same rule as probe_out/ — never committed, never travels back
ita_cache/
